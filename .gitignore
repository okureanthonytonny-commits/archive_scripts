# Runtime state — regenerated per-run, not code
.state
.state_log.tsv

# Throwaway test output — env_sanity_test.sh's own scratch manifest
tests/sanity_manifest.tsv

# Real media fixtures — binary, not meant to live in git history
tests/fixtures/**/*.mp4
tests/fixtures/**/*.webp
tests/fixtures/**/*.mov

# Scratch patch scripts — self-delete on success, shouldn't persist
.patches/*

.env
